{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseaxis.dev/schema/academic-provider-catalog.schema.json",
  "title": "CourseAxis Academic Provider Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
