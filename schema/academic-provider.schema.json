{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseaxis.dev/schema/academic-provider.schema.json",
  "title": "CourseAxis Academic Provider",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "schoolName",
    "vendor",
    "adapterId",
    "sessionNamespace",
    "allowedOrigin",
    "pathPrefix",
    "loginPath",
    "homePath",
    "requiresThirdPartyCookies",
    "semesterCodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "schoolName": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "adapterId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sessionNamespace": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "allowedOrigin": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9.-]+(?::443)?$"
    },
    "pathPrefix": {
      "type": "string",
      "pattern": "^/(?:[A-Za-z0-9._~-]+/)*$"
    },
    "loginPath": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$"
    },
    "homePath": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$"
    },
    "requiresThirdPartyCookies": {
      "type": "boolean"
    },
    "semesterCodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "first": {
          "type": "string",
          "minLength": 1
        },
        "second": {
          "type": "string",
          "minLength": 1
        },
        "third": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
